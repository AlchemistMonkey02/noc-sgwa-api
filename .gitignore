# ============================================================
# sgwa-api  —  .gitignore
# Keep only core API source: app/, index.js, package.json,
# package-lock.json, Dockerfile, docker-compose.yml,
# .env.example, .dockerignore, README.md (optional)
# ============================================================

# ── Dependencies ─────────────────────────────────────────────
node_modules/

# ── Environment (real secrets; keep .env.example) ────────────
.env
.env.local
.env.production

# ── Logs ─────────────────────────────────────────────────────
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# ── OS / IDE ─────────────────────────────────────────────────
.DS_Store
Thumbs.db
.vscode/
.idea/
*.swp
*.swo

# ── Build outputs ────────────────────────────────────────────
dist/
build/

# ── Uploads / media / binary assets ─────────────────────────
uploads/
assets/
*.tar
*.tar.gz
*.zip

# ── PDF files ────────────────────────────────────────────────
*.pdf

# ── Markdown documentation files ─────────────────────────────
# (keep README.md if desired — remove its line below)
*.md
*.md.resolved

# ── Plain-text / JSON data / token dumps ────────────────────
*.txt
token.txt
debug_json.txt
temp_data.json
new_application_data.json
user-dummy-flow-meter.json

# ── Scratch / temp directories ───────────────────────────────
scratch/
doc for sgwa/
docs

# ── Seed / migration scripts ─────────────────────────────────
seeders/
seed-*.js
seed_*.js
migrate-*.js
migrate_*.js

# ── Check / verify / diagnose scripts ────────────────────────
check-*.js
check_*.js
verify_*.js
verify-*.js
diagnose-*.js
diagnose_*.js
debug-*.js
debug_*.js

# ── Test scripts (JS) ────────────────────────────────────────
test-*.js
test_*.js

# ── Test scripts (shell / PowerShell) ────────────────────────
test-*.sh
test_*.sh
test-*.ps1
test_*.ps1
*.sh
*.ps1

# ── Other one-off / utility root-level scripts ───────────────
blockClassification.js
exemptionRules.js
transitionRules.js
probe_server.js
prove_stale.js
repair_docs.js
reset-officers.js
fix-data.js
find-company.js
find_creds.js
compare-colls.js
list-collections.js
list-users.js
create-applicant.js
generate-verify-curl.js
clear_test_users.js
check_env.js
check_last_synced_user.js
diagnose_officers.js
implementation_plan.md.resolved

# ── Scripts directory ─────────────────────────────────────────
scripts/

# ── Python scripts (if any) ──────────────────────────────────
*.py
*.pyc
__pycache__/
